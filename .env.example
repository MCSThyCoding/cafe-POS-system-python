# Cafe POS Environment Variables Example
# Copy this file to .env and fill in the values

# Required in production
CAFE_POS_SECRET=your-secret-key-here

# Optional
PORT=3000
FLASK_DEBUG=0
TOKEN_HOURS=8
LOW_STOCK=10
RESTOCK_STEP=10

# For PostgreSQL deployment (Vercel, Render, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
